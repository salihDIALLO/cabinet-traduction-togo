# ============================================================
# Cabinet de Traduction Certifiée — Togo
# Variables d'environnement — MODÈLE
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env sur GitHub.
# ============================================================

# ── Base de données MySQL (profil mysql) ─────────────────────
MYSQL_URL=jdbc:mysql://localhost:3306/cabinet_traduction?useSSL=false&serverTimezone=UTC
MYSQL_USER=cabinet_user
MYSQL_PASS=CHANGE_ME

# ── Base de données PostgreSQL (profil postgres) ─────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/cabinet_traduction
POSTGRES_USER=cabinet_user
POSTGRES_PASS=CHANGE_ME

# ── Amazon S3 ────────────────────────────────────────────────
AWS_S3_BUCKET=cabinet-traduction-togo-docs
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── Spring Mail (Gmail SMTP ou autre) ────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────
# Générer avec PowerShell :
# [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
# Ou Linux/macOS : openssl rand -base64 64
JWT_SECRET=CHANGE_ME_WITH_A_64_BYTES_BASE64_SECRET

# ── FedaPay ──────────────────────────────────────────────────
# Clé API disponible sur : https://sandbox.fedapay.com (onglet API Keys)
FEDAPAY_API_KEY=CHANGE_ME
# Secret webhook disponible sur : Dashboard FedaPay → Webhooks → Secret
FEDAPAY_WEBHOOK_SECRET=CHANGE_ME
# URL de retour après paiement (ton frontend)
FEDAPAY_CALLBACK_URL=https://votre-site.tg/paiement/retour
